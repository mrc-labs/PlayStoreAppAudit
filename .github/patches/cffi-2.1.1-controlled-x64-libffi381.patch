+# Project-controlled native AMD64 consumer; never compile the bundled old libffi.
+if sys.platform != "win32" or platform.machine().lower() != "amd64" or not uses_msvc():
+    raise RuntimeError("Controlled libffi variant requires native Windows AMD64/MSVC")
+project_libffi = os.environ.get("PSAA_LIBFFI_X64_ROOT")
+if not project_libffi:
+    raise RuntimeError("Controlled libffi variant requires its source-built prefix")
+project_libffi = os.path.abspath(project_libffi)
+project_library = os.path.join(project_libffi, "lib", "libffi.lib")
+project_include = os.path.join(project_libffi, "include")
+if not all(os.path.isfile(path) for path in [project_library,
+        os.path.join(project_include, "ffi.h"), os.path.join(project_include, "ffitarget.h")]):
+    raise RuntimeError("Incomplete controlled AMD64 libffi prefix")
+include_dirs[:] = [project_include]
