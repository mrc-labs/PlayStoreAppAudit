# The source-patch digest is platform-independent, including Windows checkouts.
# Unified diff context includes a marker space on otherwise empty lines.
.github/patches/*.patch text eol=lf whitespace=-blank-at-eol

# Preserve exact audited publisher snapshot bytes.
.github/sources/*.dat text eol=lf
.github/sources/*.Cargo.lock text eol=lf

# Preserve exact source-build lock bytes across native checkouts.
.github/sources/*-controlled.package-lock.json text eol=lf

# Retained official port bytes are hash-verified before native compilation.
.github/sources/vcpkg-libffi-3.8.1/** -text whitespace=-blank-at-eol

# Exact native Node24 source-build output, including generated license bytes.
.github/actions/controlled-*/** -text
